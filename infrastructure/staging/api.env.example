APP_ENV=staging
APP_DEBUG=false
APP_KEY=replace-with-generated-staging-key
APP_URL=https://staging-api.example.invalid
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
DB_CONNECTION=pgsql
DB_HOST=staging-db.example.invalid
DB_DATABASE=serenity_staging
DB_USERNAME=serenity_staging
DB_PASSWORD=replace-in-secret-manager
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=staging-serenity
REVERB_APP_KEY=replace-with-staging-public-key
REVERB_APP_SECRET=replace-in-secret-manager
REVERB_HOST=staging-realtime.example.invalid
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=https://staging-web.example.invalid
CORS_ALLOWED_ORIGINS=https://staging-web.example.invalid
